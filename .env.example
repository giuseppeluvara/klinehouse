# =============================================================================
# Binance Kline Collector — environment configuration
# Copy this file to .env and fill in the required values.
# =============================================================================

# ---------------------------------------------------------------------------
# Database (required — no default passwords shipped)
# ---------------------------------------------------------------------------
POSTGRES_USER=klines
POSTGRES_PASSWORD=changeme
POSTGRES_DB=klines

# Host/port as seen by other containers (internal Docker network)
POSTGRES_HOST=timescaledb
POSTGRES_PORT=5432

# Port published on the host machine (change if 5432 is already taken)
POSTGRES_PORT_HOST=5432

# ---------------------------------------------------------------------------
# Redis
# ---------------------------------------------------------------------------
REDIS_HOST=redis
REDIS_PORT=6379

# ---------------------------------------------------------------------------
# Collection
# ---------------------------------------------------------------------------
# Comma-separated list of Binance symbols (no spaces)
SYMBOLS=BTCUSDT

# Any Binance-supported interval: 1s 1m 3m 5m 15m 30m 1h 2h 4h 6h 8h 12h 1d 3d 1w 1M
KLINE_INTERVAL=1s

# ---------------------------------------------------------------------------
# Writer / batching
# ---------------------------------------------------------------------------
# Flush to DB when this many rows are buffered…
BATCH_SIZE=50
# …or after this many seconds, whichever comes first
BATCH_INTERVAL_SECONDS=2

# ---------------------------------------------------------------------------
# TimescaleDB policies
# ---------------------------------------------------------------------------
# Compress chunks older than this (PostgreSQL interval string)
COMPRESSION_AFTER=7 days

# Drop data older than this. Leave empty to keep all raw data forever.
# Example: RETENTION_PERIOD=90 days
RETENTION_PERIOD=

# ---------------------------------------------------------------------------
# Backups (used by the optional `backup` sidecar: docker compose --profile backup up -d)
# ---------------------------------------------------------------------------
# How often the sidecar dumps the DB to ./backups (seconds; 86400 = daily)
BACKUP_INTERVAL_SECONDS=86400
# How many dumps to keep (older ones are pruned)
BACKUP_RETENTION=14

# ---------------------------------------------------------------------------
# Grafana (order-flow & volatility radar)
# ---------------------------------------------------------------------------
# Host port for the Grafana UI (change if 3000 is taken)
GRAFANA_PORT=3000
# Initial admin password (user: admin)
GRAFANA_ADMIN_PASSWORD=admin

# ---------------------------------------------------------------------------
# WebSocket / REST endpoints (override for Binance testnet)
# ---------------------------------------------------------------------------
WS_BASE_URL=wss://stream.binance.com:9443
REST_BASE_URL=https://api.binance.com

# ---------------------------------------------------------------------------
# Reconnection
# ---------------------------------------------------------------------------
# Maximum backoff between reconnection attempts (seconds)
RECONNECT_MAX_BACKOFF=60

# ---------------------------------------------------------------------------
# Heartbeat & monitoring
# ---------------------------------------------------------------------------
# Interval between heartbeats written to Redis (seconds)
HEARTBEAT_INTERVAL=10

# Optional: URL pinged on each heartbeat (Healthchecks.io / Uptime Kuma).
# Leave empty to disable.
HEALTHCHECK_URL=

# ---------------------------------------------------------------------------
# Logging
# ---------------------------------------------------------------------------
# DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# ---------------------------------------------------------------------------
# Optional verified archive: docker compose --profile archive up -d --build archive
# ---------------------------------------------------------------------------
# Host tools and research/db.py route reads here when set.
# Existing raw DB retention must stay disabled during migration.
ARCHIVE_ROOT=archive
# Used by the archive sidecar (create this directory on the host first).
ARCHIVE_USER=1000:1000
# Optional host location for DuckDB spill files (fast SSD recommended).
# MARKET_TEMP_DIR=/path/to/ssd/tmp
